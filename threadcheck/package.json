{
  "name": "threadcheck",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@js-temporal/polyfill": "^0.5.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "expo": "~58.0.25",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.20",
    "expo-font": "~58.0.12",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-local-authentication": "~58.0.3",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "otpauth": "^9.6.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-qrcode-svg": "^6.3.54",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "~19.3.0",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "server": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "export:web": "expo export --platform web",
    "build:server": "esbuild server/runtime.ts --bundle --platform=node --format=esm --packages=external --target=node24 --outfile=server-dist/runtime.mjs",
    "build:vercel": "npm run export:web && npm run build:server",
    "dev": "node scripts/dev.mjs",
    "format": "prettier --write App.tsx src shared server/*.ts tests scripts",
    "lint": "eslint .",
    "db:start": "supabase start -x gotrue,realtime,storage-api,imgproxy,mailpit,edge-runtime,logflare,vector,supavisor",
    "db:migrate": "supabase migration up",
    "setup:local": "node scripts/setup-local.mjs"
  },
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "type": "module"
}
